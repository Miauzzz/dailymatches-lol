# ============================================
# Dailymatches-lol — Variables de entorno
# ============================================
# Copiá este archivo como .env y completá los valores.
# En producción (Cloudflare Workers) usá:
#   wrangler secret put RIOT_API_KEY
#   wrangler secret put MONGO_URI
#   wrangler secret put MONGO_DB_NAME

RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MONGO_URI=mongodb+srv://usuario:password@cluster.xxxxx.mongodb.net/?appName=tu-app
MONGO_DB_NAME=tu_database
